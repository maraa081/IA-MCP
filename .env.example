# =============================================================================
# Copier ce fichier en .env puis adapter. Le .env n'est JAMAIS versionne.
# =============================================================================

# --- Gateway LiteLLM (proxy OpenAI-compatible devant Ollama) -----------------
GATEWAY_URL=http://127.0.0.1:4000
# Interface d'ecoute de la gateway. 0.0.0.0 la rend joignable par les conteneurs
# Docker (Open WebUI) via l'IP de WSL. Remettre 127.0.0.1 pour fermer l'acces.
GATEWAY_HOST=0.0.0.0
# Port d'ecoute de la gateway LiteLLM (change rarement).
GATEWAY_PORT=4000
# Cle de service de l'orchestrateur : cle virtuelle creee par
# scripts/virtual_keys.sh (voir gateway/README.md). Sans base de donnees,
# LiteLLM n'accepte que la cle maitresse : c'est alors la meme valeur que
# GATEWAY_MASTER_KEY.
GATEWAY_API_KEY=sk-master-lab-0001
# Cle maitre de la gateway (administration). A ne pas distribuer.
GATEWAY_MASTER_KEY=sk-master-lab-0001

# Base PostgreSQL de la gateway : cles virtuelles, quotas, historique des appels.
# Mise en place : ./scripts/setup_db.sh puis ./scripts/enable_db.sh
# Laisser cette ligne absente : install.sh (ou scripts/setup_db.sh) la
# cree avec un mot de passe genere, qui n'est jamais affiche.
# LITELLM_DATABASE_URL=postgresql://litellm:MOT_DE_PASSE@127.0.0.1:5433/litellm

# Cle virtuelle propre aux serveurs MCP : plus restrictive que celle de
# l'orchestrateur (modele de redaction seulement, pas le planificateur).
# Laisser vide pour retomber sur GATEWAY_API_KEY.
MCP_GATEWAY_API_KEY=

# --- Ollama ------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Modele physique derriere les deux alias de gateway/config.yaml.
# Choix guide : ./install.sh. Conseils : qwen3.5:4b (CPU correct),
# qwen3.5:2b (CPU modeste ou 8 Go de RAM), qwen3.5:0.8b (tres faible),
# qwen3.5:9b (GPU).
OLLAMA_MODEL=qwen3.5:4b
# Alias definis dans gateway/config.yaml -> voir ce fichier
PLANNER_MODEL=planner
WRITER_MODEL=writer
SUMMARIZER_MODEL=writer

# --- Orchestrateur -----------------------------------------------------------
ORCHESTRATOR_URL=http://127.0.0.1:8090
ORCHESTRATOR_ISSUER=mcp-orchestrator-lab
ORCHESTRATOR_AUDIENCE=orchestrator-api
# Mode de selection d'outil : native (function calling) | json (prompt+JSON) | auto
PLANNER_MODE=auto

# Identifiants de demonstration pour POST /auth/token
# En production, remplacer par un vrai fournisseur d'identite (Keycloak, EntraID).
DEV_USERNAME=demo
DEV_PASSWORD=changeme-lab

# --- Serveurs MCP ------------------------------------------------------------
MCP_SUMMARIZER_URL=http://127.0.0.1:9101/mcp
MCP_CODEDOC_URL=http://127.0.0.1:9102/mcp
MCP_CODEDB_URL=http://127.0.0.1:9103/mcp
# Base de code lue par le serveur codedb (chemins relatifs a la racine du projet).
# Alimentee par : python scripts/index_code.py
CODEDB_PATH=var/codedb.sqlite

# Duree de vie du jeton d'acces en secondes (900 = 15 min, valeur recommandee).
ACCESS_TOKEN_TTL_SECONDS=900

# Desactiver la phase de reflexion du modele. Recommande : un modele de
# raisonnement peut consommer tout son budget de tokens en reflexion et rendre un
# contenu vide, sans erreur.
OLLAMA_DISABLE_THINKING=true

# Interface decoute de l API. 0.0.0.0 rend l interface accessible depuis le
# navigateur Windows (adresse http://<ip-wsl>:8090/ui). Remettre 127.0.0.1
# ensuite. Voir la section "Depuis un navigateur" du README.
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8090

# --- Passerelle d'outils (mcpo) ----------------------------------------------
# Traduit les serveurs MCP en OpenAPI pour Open WebUI. MCPO_API_KEY est generee
# par scripts/bridge.sh au premier lancement.
MCPO_HOST=0.0.0.0
MCPO_PORT=9300
MCPO_URL=http://127.0.0.1:9300

# --- Open WebUI (facade de chat) ----------------------------------------------
# http://localhost:3000 : le conteneur lit les modeles sur la gateway LiteLLM.
# WEBUI_SECRET_KEY est generee par scripts/openwebui.sh au premier lancement.
OPENWEBUI_PORT=3000
OPENWEBUI_URL=http://127.0.0.1:3000

# --- Modele de decision Laya (planificateur) --------------------------------
# Sidecar local : ./scripts/laya.sh up. Necessite .venv-laya.
# Laya choisit l'outil ; le modele de langage extrait ensuite les arguments.
# Laisser PLANNER_MODE=auto pour ne pas l'utiliser. Passer a "laya" pour
# l'activer ; en cas d'indisponibilite, le planificateur retombe sur qwen.
LAYA_PORT=9104
LAYA_URL=http://127.0.0.1:9104
LAYA_MODEL=convaiinnovations/laya-multilingual
LAYA_MIN_CONFIDENCE=0.01
LAYA_MIN_MARGIN=0.02

# --- Delais (secondes) ------------------------------------------------------
# Doit rester inferieur au timeout du client MCP de l'orchestrateur.
TOOL_TIMEOUT_SECONDS=900
